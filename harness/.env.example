# Copy to harness/.env (git-ignored) and fill in. Never commit real values.

# Superlinked SIE Serverless: https://console.superlinked.com/console/keys
# Either name works; SIE_API_KEY is what the Superlinked cookbook uses.
SUPERLINKED_API_KEY=
# Leave empty for SIE Serverless (https://api.superlinked.com); set for SIE Cluster or SIE Local.
SIE_BASE_URL=

# Senso: cited passages for /evidence and the shoe pick. Without a key, cached passages are returned (live: false).
SENSO_API_KEY=
# Leave empty for the default Senso API base URL.
SENSO_BASE_URL=

# Optional: when set, /shoes/recommend and /warm require the X-Harness-Secret header (/evidence stays open).
HARNESS_SECRET=

# Optional: Amplitude (used by memory-agent; the harness doesn't send events yet).
AMPLITUDE_API_KEY=
