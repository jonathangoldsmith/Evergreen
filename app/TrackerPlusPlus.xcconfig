// Base configuration of the TrackerPlusPlus app target (Debug and Release).
// AMPLITUDE_API_KEY comes from the git-ignored Secrets.xcconfig next to this file:
//
//   AMPLITUDE_API_KEY = <your project API key>
//
// Without that file the key is empty and the app sends no Amplitude events.
#include? "Secrets.xcconfig"

// Merged with the generated Info.plist; carries AMPLITUDE_API_KEY into the app.
INFOPLIST_FILE = TrackerPlusPlus-Info.plist
